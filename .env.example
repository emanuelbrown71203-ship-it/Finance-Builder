# Copy to .env.local. With nothing set, the app runs in demo mode on sample data.

# --- Database -------------------------------------------------------------
# Postgres connection string. On Supabase: Project Settings > Database >
# Connection string > "Session pooler" (port 5432). Not the transaction pooler
# (port 6543): the database driver sends several queries at once and the
# transaction pooler hangs on that. Leave empty to use the built-in
# in-memory database (fine for trying things out; data resets on restart).
# A deployed site with Plaid keys refuses to start without it.
# Sharing a database with other apps? See "Sharing a database" in the README.
DATABASE_URL=
# Optional: keep the password out of the address above (write the address
# without one) and put it here on its own instead.
# DATABASE_PASSWORD=

# --- Bank connections (Plaid) ----------------------------------------------
# From https://dashboard.plaid.com/developers/keys. Setting these two turns
# off demo mode: people sign in and link their own banks.
PLAID_CLIENT_ID=
PLAID_SECRET=
# "sandbox" (practice banks, free) or "production" (real banks).
PLAID_ENV=sandbox

# The public address of this app, e.g. https://passbook.example.com. Required
# with Plaid: sign-in, passkeys and the "did this come from our own pages"
# check are tied to it, and Plaid sends "new transactions" notices to
# <APP_URL>/api/plaid/webhook.
APP_URL=

# New accounts need this invite code. Leave it empty and nobody new can sign
# up. Remove it again once everyone in the household has an account.
SIGNUP_CODE=

# Encrypts bank access tokens before they are stored. Required with Plaid.
# Generate once with: openssl rand -base64 32   (never change it afterwards,
# or existing bank connections can no longer be read)
TOKEN_ENCRYPTION_KEY=

# --- Optional ---------------------------------------------------------------
# The one Tasks for Two server the bills link may talk to, e.g.
# abcdefghijklmnopqrst.supabase.co. Without it the link can't be connected.
# TASKS_FOR_TWO_HOST=
# Force demo mode on (1) or off (0) regardless of the Plaid keys.
# DEMO_MODE=
# Time zone used for "today" when the browser doesn't report one.
# APP_TIMEZONE=America/New_York
# Only needed for bank sign-ins that redirect on phones (OAuth).
# PLAID_REDIRECT_URI=
